{
  "name": "mcp-upgrade",
  "version": "0.1.0",
  "description": "Find what breaks before you upgrade your MCP server. Static scanner for MCP 2025-11-25 -> 2026-07-28 RC migration.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "migration",
    "scanner",
    "static-analysis",
    "upgrade",
    "compatibility",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-upgrade": "dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/rule-matrix.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-executable.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts",
    "prepack": "npm run clean && npm run build",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "fast-glob": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
