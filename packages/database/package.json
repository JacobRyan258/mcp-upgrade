{
  "name": "@mcp-upgrade/database",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres schema, migrations and server-only data access for the hosted validator.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx src/cli.ts migrate",
    "reset": "tsx src/cli.ts reset",
    "status": "tsx src/cli.ts status"
  },
  "dependencies": {
    "@mcp-upgrade/shared": "*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
