# MCP Upgrade — environment template.
#
# Copy the web block to apps/web/.env.local and the worker block to
# apps/worker/.env. Both are gitignored.
#
# Every variable listed without a default is required: the application validates
# its configuration at startup and refuses to run rather than falling back to a
# silent default. There are no test-only fallbacks outside NODE_ENV=test.
#
# Nothing in this file is a real credential.

# =============================================================================
# Web application (apps/web/.env.local)
# =============================================================================

# --- Public. These are inlined into the browser bundle by design. ------------

# The canonical origin. Must be https and must not be localhost in production;
# the startup check refuses both.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and anonymous key. The anon key is public: every query it
# can make is constrained by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Only needed if you add a client-side Stripe flow; the current
# checkout is entirely server-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Server only. Never prefix any of these with NEXT_PUBLIC_. ---------------

# Full database access. Used for the transactional work that must bypass RLS:
# allowance reservation, job creation and webhook writes.
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Used only to write and delete staged uploads in object storage. This key
# bypasses row level security entirely — treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private bucket for staged uploads. Must not be public.
SUPABASE_UPLOAD_BUCKET=scan-uploads

# Shared with the worker. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_SHARED_SECRET=generate-a-long-random-value-at-least-32-chars

# Optional. The worker's authenticated status endpoint, for an operator page.
# WORKER_STATUS_URL=https://worker.example.com/status

# --- Stripe. All three must be set for billing to be offered at all. ---------
# Leave them unset and the application runs Free-plan-only, saying so in the UI
# rather than showing a checkout button that would fail.
#
# TEST MODE ONLY. A production deployment refuses to start with an sk_live_ key.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...

# Optional. Raises GitHub's anonymous rate limit. Grants no access to private
# repositories — those are rejected before an archive is ever requested.
# GITHUB_TOKEN=ghp_...

# =============================================================================
# Worker (apps/worker/.env)
# =============================================================================

# Same database the web app writes jobs to.
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Must match the web application's value exactly.
WORKER_SHARED_SECRET=generate-a-long-random-value-at-least-32-chars

# Storage access, to fetch and then delete staged uploads.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_UPLOAD_BUCKET=scan-uploads

# Identity in logs and in the job lease. Give each replica its own.
WORKER_ID=worker-1
WORKER_PORT=8080

# How often to poll when the queue is empty, and how many jobs to run at once.
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1

# How long a claimed job may stay running before the reaper reclaims it. Should
# comfortably exceed SCAN_TIMEOUT_MS.
WORKER_JOB_LEASE_SECONDS=900

# The only directory the worker writes to. In the container this is /scans and
# is the only writable mount.
SCAN_TEMP_ROOT=/tmp/mcp-upgrade-scans

# Resource ceilings. These are upper bounds: a plan may be more restrictive, and
# a value above the compiled-in absolute maximum is clamped down to it, so a
# typo here can never widen exposure.
SCAN_TIMEOUT_MS=300000
SCAN_MAX_ARCHIVE_BYTES=262144000
SCAN_MAX_EXPANDED_BYTES=1610612736
SCAN_MAX_FILES=60000
SCAN_MAX_FILE_BYTES=8388608

GITHUB_DOWNLOAD_TIMEOUT_MS=60000
# GITHUB_TOKEN=ghp_...

# =============================================================================
# Local development and tests
# =============================================================================

# Points the database test suite at a disposable Postgres. Never point this at
# anything you care about.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/mcp_upgrade_test

# Required by `npm run db:reset`, which drops every table. Deliberately awkward.
# ALLOW_DESTRUCTIVE_RESET=yes
