# MCP Upgrade — environment template.
#
# ---------------------------------------------------------------------------
# THIS FILE IS DOCUMENTATION. IT IS NEVER LOADED AT RUNTIME.
# ---------------------------------------------------------------------------
#
# Copy it to `.env` at the repository root and fill in real values:
#
#     cp .env.example .env && chmod 600 .env
#
# `.env` at the repository root is the ONLY local file this project loads. It
# is loaded explicitly by `scripts/with-env.mjs`, which every dev, build,
# start, worker, migration and Stripe command runs through.
#
# In particular there is no per-workspace configuration. `apps/web/.env.local`
# and `apps/worker/.env` are deliberately kept empty and defining anything in
# them is a hard startup error — Next.js loads `.env.local` automatically and
# would otherwise outrank this file. That is not hypothetical: it is how this
# repository ended up running the web app against one Stripe account while the
# provisioning scripts were configured for another.
#
# In a hosted deployment (Vercel, Fly, a container) there is no `.env` at all.
# The platform's own environment variables are the source of truth, and the
# loader detects that and stands aside. See docs/stripe.md.
#
# Every placeholder below is deliberately too short or too obviously fake to
# satisfy startup validation, so a `.env` copied through unchanged fails loudly
# instead of booting half-configured. `npm run verify:env-files` enforces that.
#
# Nothing in this file is a real credential.

# =============================================================================
# Application
# =============================================================================

# --- Public. These are inlined into the browser bundle at BUILD time. --------
# Because they are inlined by `next build`, they must be correct when the build
# runs, not merely when the server starts.

# The canonical origin. Must be https and must not be localhost in production;
# the startup check refuses both.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and anonymous key. The anon key is public: every query it
# can make is constrained by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server only. Never prefix any of these with NEXT_PUBLIC_. ---------------

# Full database access. Used for the transactional work that must bypass RLS:
# allowance reservation, job creation and webhook writes.
#
# Supabase pooler guidance (the pool never sends statement_timeout as a startup
# parameter, so every mode below works — see packages/database/src/pool.ts):
#   - Serverless web (Vercel): TRANSACTION pooler, port 6543.
#       postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
#   - Migrations and the worker: SESSION pooler, port 5432 (advisory locks).
#       postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Storage access, to write, fetch and delete staged uploads. This key bypasses
# row level security entirely — treat it like a database password.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Private bucket for staged uploads. Must not be public.
SUPABASE_UPLOAD_BUCKET=scan-uploads

# Shared between the web app and the worker; they must agree exactly. At least
# 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_SHARED_SECRET=generate-a-long-random-value-at-least-32-chars

# Optional. The worker's authenticated status endpoint, for an operator page.
# WORKER_STATUS_URL=http://127.0.0.1:8080/status

# Optional. Raises GitHub's anonymous rate limit. Grants no access to private
# repositories — those are rejected before an archive is ever requested.
# GITHUB_TOKEN=ghp_your_token_here

# =============================================================================
# Stripe — TEST MODE ONLY
# =============================================================================
#
# All four values must belong to the SAME Stripe account and the SAME mode.
# Matching prefixes is not sufficient and is not what is checked: startup
# validation refuses a live-mode credential outright, and
# `npm run verify:stripe-env` additionally resolves the price against the API
# so a test key paired with another account's price id fails instead of
# producing "No such price" at a customer's checkout.
#
# Leave all four unset and the application runs Free-plan-only, saying so in
# the UI rather than showing a checkout button that would fail.
#
# Provision the test-mode product, price, webhook endpoint and customer portal
# with:
#   npm run stripe:setup -- --production-base-url https://upgrade.jacobryanlive.com

# Must begin with pk_test_. A pk_live_ key is refused.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Must begin with sk_test_ or rk_test_. A live-mode key is refused.
STRIPE_SECRET_KEY=sk_test_...

# Must begin with whsec_. NOTE: this is a SIGNING SECRET, not a webhook
# endpoint id — an endpoint id begins with `we_` and will never verify a
# signature. The two are easy to confuse in the dashboard.
#
# For local development this is the Stripe CLI's forwarding secret:
#   npm run stripe:listen
# For a hosted deployment it is the endpoint's secret, revealed once in the
# dashboard. The two are NOT interchangeable.
STRIPE_WEBHOOK_SECRET=whsec_...

# Must begin with price_ and resolve, in this account and mode, to an active
# recurring price of 1900 usd every 1 month.
STRIPE_PRO_MONTHLY_PRICE_ID=price_...

# =============================================================================
# Worker
# =============================================================================

# Identity in logs and in the job lease. Give each replica its own.
WORKER_ID=worker-1
WORKER_PORT=8080

# How often to poll when the queue is empty, and how many jobs to run at once.
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=1

# How long a claimed job may stay running before the reaper reclaims it. Should
# comfortably exceed SCAN_TIMEOUT_MS.
WORKER_JOB_LEASE_SECONDS=900

# The only directory the worker writes to. In the container this is /scans and
# is the only writable mount.
SCAN_TEMP_ROOT=/tmp/mcp-upgrade-scans

# Resource ceilings. These are upper bounds: a plan may be more restrictive, and
# a value above the compiled-in absolute maximum is clamped down to it, so a
# typo here can never widen exposure.
SCAN_TIMEOUT_MS=300000
SCAN_MAX_ARCHIVE_BYTES=262144000
SCAN_MAX_EXPANDED_BYTES=1610612736
SCAN_MAX_FILES=60000
SCAN_MAX_FILE_BYTES=8388608

GITHUB_DOWNLOAD_TIMEOUT_MS=60000

# =============================================================================
# Local development and tests
# =============================================================================

# Points the database test suite at a disposable Postgres. Never point this at
# anything you care about.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/mcp_upgrade_test

# Required by `npm run db:reset`, which drops every table. Deliberately awkward.
# ALLOW_DESTRUCTIVE_RESET=yes
